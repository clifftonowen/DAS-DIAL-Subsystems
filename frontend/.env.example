# Copy to frontend/.env and fill in. PLACEHOLDERS ONLY — never commit a real value here.
#
# All three are INLINED INTO THE BUNDLE at build time, not read at runtime. Two consequences:
#   1. One built image cannot be promoted between environments — build once per environment.
#   2. Only put public values here. The anon key is designed to be public and is safe because row
#      level security is enabled; the service-role key never belongs in this file.
# vite.config.js fails the build when any of them is missing, because the alternative is shipping
# a bundle that looks fine and cannot talk to the API.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# Where the API lives. Must match a scheme+host+port listed in the backend's CORS_ORIGINS, or
# login fails with "Failed to fetch". In production this is the deployed API origin.
VITE_API_URL=http://localhost:8000
