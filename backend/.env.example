# Copy to backend/.env and fill in. PLACEHOLDERS ONLY — never commit a real value here.
# This file was previously committed with live credentials in it; see git history for why that
# matters. Every setting not listed below has a working default documented in app/core/config.py.

# --- Supabase (required; the app will not start without these three) -------------------------
# Project Settings -> API. SUPABASE_KEY is the service-role key and is BACKEND ONLY — it bypasses
# row level security, so it must never reach the browser or a VITE_ variable.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=<your-service-role-key>
SUPABASE_JWT_SECRET=<your-jwt-secret>

# --- Model providers -------------------------------------------------------------------------
# Completion and embedding are chosen separately. Both default to "ollama", which needs
# `ollama serve` running locally and no key.
#
# EMBEDDING_PROVIDER and USE_EMBEDDING_ALT must agree — gemini embeddings are ranked against the
# `embedding_alt` column, everything else against `embedding`. The app refuses to boot on a
# mismatch (Settings.verify) because the failure is otherwise silent: comparing two models'
# vectors returns confident nonsense, not an error.
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
USE_EMBEDDING_ALT=false
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Retrieval gate: refuse before spending an LLM call when the best chunk is too weak to ground an
# activity. PER-MODEL — derive it, never guess, with:
#     python -m scripts.calibrate_gate --provider <p> --column <embedding|embedding_alt>
# Measured on this corpus: nomic-embed-text => 0.67, gemini-embedding-001 => 0.71.
MIN_SIMILARITY=0.67

# --- App -------------------------------------------------------------------------------------
# Comma-separated browser origins. The UI signs in through this API rather than through Supabase
# directly, so a deployed frontend origin missing here breaks LOGIN, and it surfaces in the
# browser as a bare "Failed to fetch" with no status to report.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Set false on a public deployment so visitors use the seeded demo account instead of creating
# accounts against a shared LLM key.
SIGNUP_ENABLED=true

# --- Email (optional) ------------------------------------------------------------------------
# With EMAIL_ENABLED=false, /share PRINTS what it would have sent and still returns
# {"sent": true}. Leave it off only if the UI is honest about being a demo.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
